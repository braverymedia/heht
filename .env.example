# Site Configuration
SITE_URL=https://higheredhottakes.com
ELEVENTY_SITE_URL=https://higheredhottakes.com

# Bunny.net CDN Configuration
BUNNY_CDN_URL=https://la.storage.bunnycdn.com
BUNNY_STORAGE_ZONE=630752
BUNNY_API_KEY=your-api-key-here
BUNNY_REGION=la  # Optional: la, ny, sg, etc. (defaults to la if not specified)

# Bunny.net cache purge (optional but recommended) — without these, `npm
# run deploy` uploads the new build but never tells the CDN to drop its
# old cached copies, so the live site can keep serving stale pages
# indefinitely (pages carry a 1-year Cache-Control). Find the pull zone ID
# on its settings page in the Bunny dashboard; the account API key is
# under Account Settings > API (different key from BUNNY_API_KEY above,
# which is scoped to the storage zone only).
BUNNY_PULL_ZONE_ID=your-pull-zone-id-here
BUNNY_ACCOUNT_API_KEY=your-account-api-key-here