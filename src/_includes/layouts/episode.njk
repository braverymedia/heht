---
layout: layouts/base.njk
---

{% set isEpisodePage = true %}
{% set episode = {
    "url": url,
    "title": title,
    "date": date,
    "number": number,
    "duration": audio?.duration,
    "description": description,
    "transcript": transcript,
    "cover": {
        "image": cover.image
    }
} %}

<article class="episode h-entry" itemscope itemtype="http://schema.org/PodcastEpisode">
  <script type="application/ld+json">
    {{ {
      "@context": "https://schema.org",
      "@type": "PodcastEpisode",
      "name": title,
      "datePublished": date,
      "episodeNumber": number,
      "duration": audio?.duration,
      "description": description,
      "url": url,
      "partOfSeries": {
        "@type": "PodcastSeries",
        "name": podcast?.title,
        "url": podcast?.siteUrl
      }
    } | json | safe }}
  </script>

  <header>
    <h1>{{ title }}</h1>
    <p class="episode-meta">Episode {{ number | padStart(3, '0') }} • {{ date | readableDate }}</p>
  </header>
  
  <div class="episode-content">
    {{ content | safe }}
  </div>
</article>