---
layout: layouts/base.njk
pageType: episode
---

{# Home page passes latestEpisode = true; episode pages have their own front matter #}
{% if latestEpisode %}
  {% set episodeItem = episodes.latest(collections) %}
  {% set episode = {
    url: episodeItem.url,
    title: episodeItem.data.title,
    date: episodeItem.data.date,
    number: episodeItem.data.number,
    audio: episodeItem.data.audio,
    video: episodeItem.data.video,
    description: episodeItem.data.description,
    transcript: episodeItem.data.transcript,
    cover: episodeItem.data.cover
  } %}
  {% set episodeContent = episodeItem.content %}
  {% set isEpisodePage = true %}
  {% set isLatest = true %}
{% else %}
  {% set episode = {
    url: page.url,
    title: title,
    date: date,
    number: number,
    audio: audio,
    video: video,
    description: description,
    transcript: transcript,
    cover: cover
  } %}
  {% set isEpisodePage = true %}
  {% set isLatest = false %}
{% endif %}

{# ── Content Column (rail + detail) ───────────────────── #}
<div class="content-column">
  <nav class="rail" aria-label="Site navigation">
    {% include "../../_components/nav-rail.njk" %}
  </nav>

  <article class="detail" id="main" tabindex="-1">
    {# Always-visible pull tab — single toggle for detail collapse/expand.
       Same pattern as .rail__tab. #}
    <button class="detail__tab" id="detail-tab" aria-expanded="true" aria-controls="main" aria-label="Toggle episode details"></button>

    {# Episode list overlay #}
    <div class="episode-list-panel" id="episode-list-panel" aria-hidden="true">
      <div class="episode-list-panel__header">
        <button class="episode-list-panel__back" id="episode-list-back" aria-label="Back to episode">
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path d="M10 3L5 8L10 13" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
          Back
        </button>
        <h2 class="episode-list-panel__title">All Episodes</h2>
      </div>
      <ul class="episode-list-panel__list" role="list">
        {% for ep in collections.episodes %}
        <li>
          <a href="{{ ep.url }}" class="episode-list-panel__item">
            <span class="episode-list-panel__num">{{ ep.data.number | padStart(3, '0') }}</span>
            <span class="episode-list-panel__name">{{ ep.data.title }}</span>
            <span class="episode-list-panel__dur">{{ ep.data.audio.duration | durationHuman }}</span>
          </a>
        </li>
        {% endfor %}
      </ul>
    </div>

    {# Newsletter slide-in #}
    <div class="slide-panel" id="newsletter-panel" aria-hidden="true">
      <div class="slide-panel__header">
        <button class="slide-panel__back" id="newsletter-back" aria-label="Back to episode">
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path d="M10 3L5 8L10 13" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
          Back
        </button>
        <h2 class="slide-panel__title">Get Updates</h2>
      </div>
      <p class="slide-panel__desc">{{ podcast.newsletter.description }}</p>
      {% include "../../_components/newsletter-form.njk" %}
    </div>

    {# Oversized ghost episode number — fixture that animates on episode nav #}
    {% set odoNum = episode.number | padStart(3, '0') %}
    <div class="episode-odometer" id="episode-odometer" data-episode-number="{{ episode.number }}" aria-hidden="true">
      {%- for digit in odoNum %}<span class="odo-digit"><span class="odo-strip" style="transform:translateY(-{{ (digit | int) * 0.82 }}em)"><span>0</span><span>1</span><span>2</span><span>3</span><span>4</span><span>5</span><span>6</span><span>7</span><span>8</span><span>9</span></span></span>{%- endfor %}
    </div>

    {# Episode detail content #}
    <div class="detail__content" id="detail-content">
      {% include "../../_components/episode-detail.njk" %}
    </div>
  </article>
</div>

{# ── Video Panel (sibling of content-column in outer grid) ── #}
<section class="video-panel" id="video-panel" aria-label="Episode media">
  <div class="video-panel__slide" id="video-slide">
    {# Facade: cover art + play button for both audio and video episodes.
       - Audio episodes: play button triggers hidden <audio>, shows progress ring.
       - Video episodes: play button swaps facade for <video> element. #}
    <div class="media-facade"
         data-media-type="{{ 'video' if (episode.video and episode.video.src) else 'audio' }}"
         {% if episode.video and episode.video.src %}
         data-video-src="{{ episode.video.src | videoUrl(podcast) }}"
         data-video-type="{{ episode.video.type or 'video/mp4' }}"
         {% if episode.video.hls %}data-video-hls="{{ episode.video.hls | videoUrl(podcast) }}"{% endif %}
         {% endif %}
         {% if episode.audio and episode.audio.filename %}
         data-audio-src="{{ episode.audio.filename | episodeUrl(podcast) }}"
         {% endif %}
         {% if episode.transcript and episode.transcript.srt %}
         data-captions="{{ episode.transcript.srt }}"
         {% endif %}
    >
      <img src="{{ episode.video.poster or episode.cover.image if episode.video else episode.cover.image }}"
           alt="{{ episode.title }} cover art"
           class="media-facade__cover"
           id="video-poster">

      <button class="media-facade__play" aria-label="Play episode">
        <svg class="media-facade__ring" viewBox="0 0 120 120" aria-hidden="true">
          <circle class="media-facade__ring-track" cx="60" cy="60" r="54"
                  fill="none" stroke-width="3" />
          <circle class="media-facade__ring-progress" cx="60" cy="60" r="54"
                  fill="none" stroke-width="3"
                  stroke-dasharray="339.292"
                  stroke-dashoffset="339.292"
                  transform="rotate(-90 60 60)" />
        </svg>
        <span class="media-facade__icon media-facade__icon--play" aria-hidden="true">
          {% include '../../assets/svg/play.svg' %}
        </span>
        <span class="media-facade__icon media-facade__icon--pause" aria-hidden="true">
          {% include '../../assets/svg/pause.svg' %}
        </span>
      </button>
    </div>
  </div>

  <div class="ep-nav">
    <button id="prev-btn" aria-label="Previous episode" disabled>←</button>
    <button id="next-btn" aria-label="Next episode">→</button>
  </div>
</section>
