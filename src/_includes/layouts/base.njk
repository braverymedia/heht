{# Set currentEpisode to the current page's episode, or fallback to latest #}
{% if not currentEpisode %}
  {% if episode %}
    {% set currentEpisode = episode %}
  {% elif collections.episodes and collections.episodes[0] %}
    {% set currentEpisode = collections.episodes[0].data %}
  {% endif %}
{% endif %}
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  {% if site.env === "production" %}
    <meta http-equiv="Cache-Control" content="public, max-age=31536000">
  {% else %}
    <meta http-equiv="Cache-Control" content="no-cache, no-store, must-revalidate">
    <meta http-equiv="Pragma" content="no-cache">
    <meta http-equiv="Expires" content="0">
  {% endif %}
  <title>{% if title %}{{ title }} - {{ podcast.title }}{% else %}{{ podcast.title }}{% endif %}</title>

  {% include "../../_components/meta.njk" %}

  <!-- Fonts: Bunny Fonts (privacy-friendly Google Fonts mirror) -->
  <link rel="preconnect" href="https://fonts.bunny.net" crossorigin>
  <link rel="stylesheet" href="https://fonts.bunny.net/css?family=plus-jakarta-sans:400,400i,600,600i&display=swap">

  <!-- Styles -->
  {% include "../styles.njk" %}

  <!-- Favicon -->
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <link rel="apple-touch-icon" href="/apple-touch-icon.png">
  <link rel="manifest" href="/manifest.webmanifest">
</head>
<body data-type="{{ pageType }}">
  <a href="#main" class="skip-link">Skip to main content</a>

  {# ── Shell ───────────────────────────────────────────────────
     Child layouts output the full shell interior:
     - Episode/home: .content-column (rail + detail) + .video-panel
     - Pages: .content-column (rail + page-content)
     The nav rail is included by each child layout inside .content-column.
  #}
  <div class="shell{% if pageType == 'episode' %} shell--media{% endif %}" id="shell">
    {{ content | safe }}
  </div>

  {# ── JavaScript ──────────────────────────────────────────── #}
  {% if site.env === "production" %}
    {% include '../scripts.njk' %}
  {% else %}
    <script src="{{ '/assets/js/newsletter-form.js' | url }}?v={{ cacheBust }}" defer></script>
    <script src="{{ '/assets/js/panel-controller.js' | url }}?v={{ cacheBust }}" type="module"></script>
    <script src="{{ '/assets/js/media-controller.js' | url }}?v={{ cacheBust }}" type="module"></script>
    <script src="{{ '/assets/js/episode-nav.js' | url }}?v={{ cacheBust }}" type="module"></script>
  {% endif %}
</body>
</html>
