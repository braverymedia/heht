{# Set currentEpisode to the current page's episode, or fallback to latest #}
{% if not currentEpisode %}
  {% if episode %}
    {% set currentEpisode = episode %}
  {% elif collections.episodes and collections.episodes[0] %}
    {% set currentEpisode = collections.episodes[0].data %}
  {% endif %}
{% endif %}
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  {% if site.env === "production" %}
    <meta http-equiv="Cache-Control" content="public, max-age=31536000">
  {% else %}
    <meta http-equiv="Cache-Control" content="no-cache, no-store, must-revalidate">
    <meta http-equiv="Pragma" content="no-cache">
    <meta http-equiv="Expires" content="0">
  {% endif %}
  <title>{% if title %}{{ title }} - {{ podcast.title }}{% else %}{{ podcast.title }}{% endif %}</title>

  {% include "../../_components/meta.njk" %}

  <!-- Fonts: Bunny Fonts (privacy-friendly Google Fonts mirror) -->
  <link rel="preconnect" href="https://fonts.bunny.net" crossorigin>
  <link rel="stylesheet" href="https://fonts.bunny.net/css?family=plus-jakarta-sans:400,400i,600,600i,800&display=swap">

  <!-- Styles -->
  {% include "../styles.njk" %}

  <!-- Favicon -->
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <link rel="apple-touch-icon" href="/apple-touch-icon.png">
  <link rel="manifest" href="/manifest.webmanifest">
</head>
<body data-type="{{ pageType }}">
  <a href="#main" class="skip-link">Skip to main content</a>

  {# ── Shell ───────────────────────────────────────────────────
     Child layouts output the full shell interior:
     - Episode/home: .content-column (rail + detail) + .video-panel
     - Pages: .content-column (rail + page-content)
     The nav rail is included by each child layout inside .content-column.
  #}
  <div class="shell{% if pageType == 'episode' or pageType == 'about' %} shell--media{% endif %}" id="shell">
    {{ content | safe }}
  </div>

  {# Restore rail/detail collapse state from localStorage before first
     paint. Runs synchronously after the shell element is parsed but
     before the deferred module scripts below, so the correct layout
     is painted on first frame — no flash of un-collapsed then jump.
     Mobile is skipped because the collapsed desktop classes don't
     map to the mobile bottom-bar + vertical-stack layout. #}
  <script>
    (function () {
      try {
        if (matchMedia('(max-width: 767px)').matches) return;
        var s = JSON.parse(localStorage.getItem('heht-panel-state') || '{}');
        var el = document.getElementById('shell');
        if (!el) return;
        if (s && s.railCollapsed) el.classList.add('rail-collapsed');
        if (s && s.detailCollapsed) el.classList.add('detail-collapsed');
      } catch (e) {}
    })();
  </script>

  {# ── JavaScript ────────────────────────────────────────────
     Production: single Rollup bundle.
     Dev: index.js loaded as a module — its static imports pull in
     panel-controller / media-controller / episode-nav / newsletter-form.
     Both paths go through the same single entry so the init functions
     are only called once. Previously each module had an auto-init at
     its tail AND index.js called them explicitly, which double-bound
     every event listener in the bundle and broke the collapse toggles.
  #}
  {% if site.env === "production" %}
    {% include '../scripts.njk' %}
  {% else %}
    <script src="{{ '/assets/js/index.js' | url }}?v={{ cacheBust }}" type="module"></script>
  {% endif %}
</body>
</html>
