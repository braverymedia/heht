    }
    .media video,
    .media audio {
      width: 100%;
      display: block;
    }
    .media__label {
      font-family: var(--font-display);
      font-size: 0.8rem;
      letter-spacing: 0.24em;
      text-transform: uppercase;
      color: var(--ember);
      margin: 0 0 0.75rem;
    }

    /* ---------- body prose ---------- */
    .prose {
      max-width: 38rem;
      font-size: 1.05rem;
    }
    .prose h2 {
      font-family: var(--font-display);
      font-weight: 900;
      font-size: clamp(2rem, 3.5vw, 3rem);
      letter-spacing: 0.01em;
      text-transform: uppercase;
      color: var(--bone);
      margin: 3rem 0 1rem;
      text-shadow: 0 0 0.4em rgba(245, 162, 93, 0.25);
    }
    .prose h3 {
      font-family: var(--font-display);
      font-weight: 700;
      font-size: 1.25rem;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: var(--ember);
      margin: 2rem 0 0.5rem;
    }
    .prose p { margin: 0 0 1.1em; }
    .prose a { color: var(--tube); text-underline-offset: 3px; }
    .prose a:hover { color: var(--ember); }

    /* ---------- chapter list ---------- */
    .chapters {
      list-style: none;
      padding: 0;
      margin: 1rem 0 2rem;
      max-width: 38rem;
      border-top: 1px solid rgba(245, 162, 93, 0.15);
    }
    .chapters li {
      display: flex;
      gap: 1.25rem;
      padding: 0.75rem 0;
      border-bottom: 1px solid rgba(245, 162, 93, 0.15);
    }
    .chapters time {
      font-family: var(--font-display);
      font-size: 0.9rem;
      letter-spacing: 0.12em;
      color: var(--ember);
      min-width: 4.5rem;
      padding-top: 0.1rem;
    }
    .chapters span { color: var(--bone); }

    /* ---------- ragged divider ---------- */
    .divider {
      display: block;
      width: 100%;
      max-width: 38rem;
      height: 18px;
      margin: 3rem 0;
      color: var(--ember);
    }
    .divider svg { width: 100%; height: 100%; display: block; opacity: 0.55; }

    /* ---------- transcript ---------- */
    .transcript {
      max-width: 38rem;
      font-size: 1rem;
      color: var(--bone-dim);
    }
    .transcript p { margin: 0 0 1em; }
    .transcript p:first-of-type::first-letter {
      font-family: var(--font-display);
      font-weight: 900;
      font-size: 6.2em;
      line-height: 0.82;
      float: left;
      padding: 0.06em 0.14em 0 0;
      margin-top: 0.05em;
      color: var(--ember);
      text-shadow:
        0 0 0.25em rgba(245, 162, 93, 0.5),
        0 0 0.6em rgba(245, 162, 93, 0.25);
    }

    /* ---------- a11y guards ---------- */
    @media (prefers-reduced-motion: reduce) {
      * { animation: none !important; transition: none !important; }
    }
    @media (prefers-reduced-transparency: reduce) {
      body::before,
      body::after { display: none; }
      .media { box-shadow: 0 0 0 1px var(--ember); }
    }
    @media (prefers-contrast: more) {
      body::before,
      body::after { display: none; }
      :root { --bone-dim: var(--bone); }
      .hero__title,
      .prose h2 { text-shadow: none; }
      .media { box-shadow: 0 0 0 2px var(--ember); }
    }
  </style>
