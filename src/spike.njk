    ];

    let current = 2; // index into episodes (start at 004)
    let animating = false;

    const shell      = document.getElementById('shell');
    const detailSlide = document.getElementById('detail-slide');
    const videoSlide  = document.getElementById('video-slide');
    const prevBtn    = document.getElementById('prev-btn');
    const nextBtn    = document.getElementById('next-btn');
    const expandDetailBtn = document.getElementById('expand-detail-btn');
    const railCollapseBtn = document.getElementById('rail-collapse-btn');
    const expandRailBtn   = document.getElementById('expand-rail-btn');

    // ── Odometer ────────────────────────────────────────────
    function setOdometer(numStr) {
      // numStr is like "004", "007"
      const digits = numStr.split('');
      digits.forEach((d, i) => {
        const strip = document.getElementById(`odo-strip-${i}`);
        if (!strip) return;
        const val = parseInt(d, 10);
        strip.style.transform = `translateY(-${val * 0.82}em)`;
      });
    }
    // init
    setOdometer('004');

    // ── Update content ──────────────────────────────────────
    function updateContent(ep) {
      document.getElementById('detail-ep-num').textContent = ep.num;
      document.getElementById('detail-title').textContent = ep.title;
      document.getElementById('detail-date').textContent = ep.date;
      document.getElementById('detail-duration').textContent = ep.duration;
      document.getElementById('detail-summary').textContent = ep.summary;

      const chapList = document.getElementById('detail-chapters');
      chapList.innerHTML = ep.chapters.map(c =>
        `<li><time>${c.time}</time><span>${c.label}</span></li>`
      ).join('');

      document.getElementById('video-poster').src = ep.cover;
      document.getElementById('video-poster').alt = `Episode ${ep.num} cover art`;
    }

    // ── Update nav buttons ──────────────────────────────────
    function updateNav() {
      prevBtn.disabled = current <= 0;
      nextBtn.disabled = current >= episodes.length - 1;
    }

    // ── Slot-machine transition ─────────────────────────────
    // Video leads, detail follows at 50%. Pure vertical slide, no fade.
    function transition(direction) {
      if (animating) return;
      animating = true;

      const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;
      const exitY = direction > 0 ? '-110%' : '110%';
      const enterY = direction > 0 ? '110%' : '-110%';

      if (reducedMotion) {
        // Instant swap
        updateContent(episodes[current]);
        setOdometer(episodes[current].num);
        updateNav();
        animating = false;
        return;
      }

      const dur = 420;
      const stagger = dur * 0.5; // detail starts when video is halfway

      // Phase 1: slide out
      const videoOut = videoSlide.animate(
        [{ transform: 'translateY(0)' }, { transform: `translateY(${exitY})` }],
        { duration: dur, easing: 'cubic-bezier(0.4, 0, 0.2, 1)', fill: 'forwards' }
      );

      // Detail follows at 50%
      setTimeout(() => {
        detailSlide.animate(
          [{ transform: 'translateY(0)' }, { transform: `translateY(${exitY})` }],
          { duration: dur, easing: 'cubic-bezier(0.4, 0, 0.2, 1)', fill: 'forwards' }
        );
      }, stagger);

      // Start odometer roll immediately
      setOdometer(episodes[current].num);

      // Phase 2: swap content and slide in
      videoOut.finished.then(() => {
        updateContent(episodes[current]);

        // Reset positions off-screen from enter direction
        videoSlide.style.transform = `translateY(${enterY})`;
        detailSlide.style.transform = `translateY(${enterY})`;

        // Cancel old animations
        videoSlide.getAnimations().forEach(a => a.cancel());
        detailSlide.getAnimations().forEach(a => a.cancel());

        // Slide video in
        const videoIn = videoSlide.animate(
          [{ transform: `translateY(${enterY})` }, { transform: 'translateY(0)' }],
          { duration: dur, easing: 'cubic-bezier(0.4, 0, 0.2, 1)', fill: 'forwards' }
        );

        // Detail follows at 50%
        setTimeout(() => {
          detailSlide.animate(
            [{ transform: `translateY(${enterY})` }, { transform: 'translateY(0)' }],
            { duration: dur, easing: 'cubic-bezier(0.4, 0, 0.2, 1)', fill: 'forwards' }
          );
        }, stagger);

        videoIn.finished.then(() => {
          // Clean up inline transforms
          videoSlide.getAnimations().forEach(a => a.cancel());
          detailSlide.getAnimations().forEach(a => a.cancel());
          videoSlide.style.transform = '';
          detailSlide.style.transform = '';
          animating = false;
        });
      });

      updateNav();
    }

    // ── Event listeners ─────────────────────────────────────
    nextBtn.addEventListener('click', () => {
      if (current < episodes.length - 1) {
        current++;
        transition(1); // forward = slide up
      }
    });

    prevBtn.addEventListener('click', () => {
      if (current > 0) {
        current--;
        transition(-1); // backward = slide down
      }
    });

    // Keyboard nav
    document.addEventListener('keydown', (e) => {
      if (animating) return;
      if (e.key === 'ArrowRight' || e.key === 'ArrowDown') {
        if (current < episodes.length - 1) {
          current++;
          transition(1);
        }
      }
      if (e.key === 'ArrowLeft' || e.key === 'ArrowUp') {
        if (current > 0) {
          current--;
          transition(-1);
        }
      }
    });

    // ── Collapse / expand ───────────────────────────────────
    expandDetailBtn.addEventListener('click', () => {
      shell.classList.remove('detail-collapsed');
    });

    railCollapseBtn.addEventListener('click', () => {
      shell.classList.add('rail-collapsed');
    });

    expandRailBtn.addEventListener('click', () => {
      shell.classList.remove('rail-collapsed');
    });
  </script>
