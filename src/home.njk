---
layout: layouts/base.njk
title: Higher Ed Hot Takes with Joel G Goodman
permalink: /
pageType: episode
---
{% set episodeItem = episodes.latest(collections) %}
{% set episodeData = episodeItem.data %}
{% set episode = {
  url: episodeItem.url,
  title: episodeData.title,
  date: episodeData.date,
  number: episodeData.number,
  audio: episodeData.audio,
  description: episodeData.description,
  transcript: episodeData.transcript,
  cover: episodeData.cover
} %}

{# ── Content Column ───────────────────────────────────── #}
<div class="content-column">
  <nav class="rail" aria-label="Site navigation">
    {% include "./_components/nav-rail.njk" %}
  </nav>

  <article class="detail" id="main" tabindex="-1">
    <button class="panel-hide detail__hide" id="detail-collapse-btn" aria-label="Hide episode details">
      <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
        <path d="M6 3L11 8L6 13" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </button>

    <div class="episode-list-panel" id="episode-list-panel" aria-hidden="true">
      <div class="episode-list-panel__header">
        <button class="episode-list-panel__back" id="episode-list-back" aria-label="Back to episode">
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path d="M10 3L5 8L10 13" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
          Back
        </button>
        <h2 class="episode-list-panel__title">All Episodes</h2>
      </div>
      <ul class="episode-list-panel__list" role="list">
        {% for ep in collections.episodes %}
        <li>
          <a href="{{ ep.url }}" class="episode-list-panel__item">
            <span class="episode-list-panel__num">{{ ep.data.number | padStart(3, '0') }}</span>
            <span class="episode-list-panel__name">{{ ep.data.title }}</span>
            <span class="episode-list-panel__dur">{{ ep.data.audio.duration | durationHuman }}</span>
          </a>
        </li>
        {% endfor %}
      </ul>
    </div>

    <div class="slide-panel" id="newsletter-panel" aria-hidden="true">
      <div class="slide-panel__header">
        <button class="slide-panel__back" id="newsletter-back" aria-label="Back to episode">
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path d="M10 3L5 8L10 13" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
          Back
        </button>
        <h2 class="slide-panel__title">Get Updates</h2>
      </div>
      <p class="slide-panel__desc">{{ podcast.newsletter.description }}</p>
      {% include "./_components/newsletter-form.njk" %}
    </div>

    <div class="detail__content" id="detail-content">
      {% set isEpisodePage = false %}
      {% include "./_components/episode-detail.njk" %}
    </div>
  </article>
</div>

{# ── Video Panel ───────────────────────────────────────── #}
<section class="video-panel" id="video-panel" aria-label="Episode media">
  {% if episode.cover.image %}
  <div class="video-panel__slide" id="video-slide">
    <img src="{{ episode.cover.image }}" alt="{{ episode.title }} cover art" id="video-poster">
  </div>
  {% endif %}

  <div class="ep-nav">
    <button id="prev-btn" aria-label="Previous episode" disabled>←</button>
    <button id="next-btn" aria-label="Next episode">→</button>
  </div>
</section>
