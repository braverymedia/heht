---
permalink: /feed/podcast.xml
eleventyExcludeFromCollections: true
---
<?xml version="1.0" encoding="utf-8"?>
<rss version="2.0"
  xmlns:itunes="http://www.itunes.com/dtds/podcast-1.0.dtd"
  xmlns:content="http://purl.org/rss/1.0/modules/content/"
  xmlns:podcast="https://podcastindex.org/namespace/1.0"
  xmlns:atom="http://www.w3.org/2005/Atom">

  <channel>
    <atom:link href="{{ podcast.feedUrl or '/feed/podcast.xml' | absoluteUrl(podcast.siteUrl) }}" rel="self" type="application/rss+xml" />
    <title>{{ podcast.title }}</title>
    <link>{{ podcast.siteUrl }}</link>
    <language>{{ podcast.language }}</language>
    <copyright>{{ podcast.copyright }}</copyright>
    <itunes:author>{{ podcast.author }}</itunes:author>
    <itunes:summary>{{ podcast.description }}</itunes:summary>
    <description>{{ podcast.description }}</description>
    <itunes:type>{{ podcast.type }}</itunes:type>
    <itunes:complete>{{ podcast.complete or "no" }}</itunes:complete>
    <podcast:locked>{{ podcast.locked or "no" }}</podcast:locked>
    <itunes:owner>
      <itunes:name>{{ podcast.owner.name }}</itunes:name>
      <itunes:email>{{ podcast.owner.email }}</itunes:email>
    </itunes:owner>
    <itunes:image href="{{ podcast.image.url | absoluteUrl(podcast.siteUrl) }}"/>
    {% for cat in podcast.categories %}
      <itunes:category text="{{ cat.name }}">
        {% if cat.subcategory %}
          <itunes:category text="{{ cat.subcategory }}"/>
        {% endif %}
      </itunes:category>
    {% endfor %}
    <itunes:explicit>{{ podcast.explicit }}</itunes:explicit>

    {% for episode in collections.episodes | reverse %}
      <item>
        <title>{{ episode.data.title }}</title>
        <itunes:title>{{ episode.data.title }}</itunes:title>
        {% if episode.data.number %}
          <itunes:episode>{{ episode.data.number }}</itunes:episode>
        {% endif %}
        {% if episode.data.season %}
          <itunes:season>{{ episode.data.season }}</itunes:season>
        {% endif %}
        {% if episode.data.episodeType %}
          <itunes:episodeType>{{ episode.data.episodeType }}</itunes:episodeType>
        {% else %}
          <itunes:episodeType>full</itunes:episodeType>
        {% endif %}
        <description>{{ episode.data.description }}</description>
        <itunes:summary>{{ episode.data.description }}</itunes:summary>
        {% if episode.templateContent %}
          <content:encoded><![CDATA[{{ episode.templateContent | removeTranscript | safe }}]]></content:encoded>
        {% endif %}
        <enclosure
          url="{{ episode.data.audio.filename | episodeUrl(podcast) }}"
          type="audio/mpeg"
          length="{{ episode.data.audio.size or 0 }}"
        />
        <guid isPermaLink="false">{{ episode.url | absoluteUrl(podcast.siteUrl) }}</guid>
        <pubDate>{{ episode.date | podcastDate }}</pubDate>
        <itunes:duration>
          {% if episode.data.audio.duration %}
            {{ episode.data.audio.duration | formatDuration }}
          {% else %}
            00:00:00
          {% endif %}
        </itunes:duration>
        <itunes:explicit>{{ episode.data.explicit or podcast.explicit }}</itunes:explicit>
        <link>{{ episode.url | absoluteUrl(podcast.siteUrl) }}</link>
        {% if episode.data.cover.image %}
          <itunes:image href="{{ episode.data.cover.image | absoluteUrl(podcast.siteUrl) }}"/>
        {% endif %}
        {% if episode.data.transcript.srt %}
          <podcast:transcript url="{{ episode.data.transcript.srt | episodeUrl(podcast) }}" type="application/x-subrip" />
        {% endif %}
        {% if episode.data.transcript.html %}
          <podcast:transcript url="{{ episode.data.transcript.html | absoluteUrl(podcast.siteUrl) }}" type="text/html" />
        {% endif %}
        {% if episode.data.transcript.vtt %}
          <podcast:transcript url="{{ episode.data.transcript.vtt | absoluteUrl(podcast.siteUrl) }}" type="text/vtt" />
        {% endif %}
        {% if episode.data.chapters %}
          <podcast:chapters url="{{ episode.data.chapters | absoluteUrl(podcast.siteUrl) }}" type="application/json+chapters" />
        {% endif %}
        {% if podcast.funding %}
          <podcast:funding url="{{ podcast.funding.url }}">{{ podcast.funding.text }}</podcast:funding>
        {% endif %}
      </item>
    {% endfor %}
  </channel>
</rss>
