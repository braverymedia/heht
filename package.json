{
	"name": "@bravery/heht",
	"version": "1.0.0",
	"main": "index.js",
	"type": "module",
	"scripts": {
		"build:css": "rollup -c rollup.config.styles.mjs",
		"watch:css": "rollup -c rollup.config.styles.mjs --watch",
		"clean": "rm -rf _site",
		"build": "npm run build:css && ELEVENTY_ENV=production npx @11ty/eleventy",
		"dev": "npm-run-all --parallel watch:css dev:eleventy",
		"dev:eleventy": "ELEVENTY_ENV=development npx @11ty/eleventy --serve",
		"start": "npm run dev",
		"debug": "DEBUG=Eleventy* npx @11ty/eleventy",
		"deploy": "node scripts/upload-to-bunny.js"
	},
	"keywords": [
		"podcast",
		"eleventy",
		"education"
	],
	"author": "",
	"license": "ISC",
	"description": "Higher Ed Hot Takes Podcast Website",
	"dependencies": {
		"@11ty/eleventy": "^3.0.0",
		"@11ty/eleventy-img": "^6.0.1",
		"@11ty/eleventy-plugin-rss": "^2.0.3",
		"@11ty/eleventy-plugin-webc": "^0.11.2",
		"@11ty/is-land": "^4.0.1",
		"@bunny.net/storage-sdk": "^0.3.0",
		"axios": "^1.8.4",
		"bunny-sdk": "^0.0.31",
		"chokidar": "^4.0.3",
		"cors": "^2.8.5",
		"dotenv": "^16.4.7",
		"express": "^5.1.0",
		"form-data": "^4.0.2",
		"loops": "^4.1.0",
		"markdown-it": "^14.1.0",
		"markdown-it-container": "^4.0.0",
		"soundtouchjs": "^0.2.1",
		"upload-to-bunny": "^1.4.0"
	},
	"devDependencies": {
		"@11ty/eleventy-plugin-bundle": "^3.0.1",
		"@rollup/plugin-commonjs": "^28.0.3",
		"@rollup/plugin-node-resolve": "^16.0.1",
		"@rollup/plugin-terser": "^0.4.4",
		"autoprefixer": "^10.4.21",
		"clean-css": "^5.3.3",
		"cssnano": "^7.0.6",
		"esbuild": "^0.25.2",
		"html-minifier": "^4.0.0",
		"npm-run-all": "^4.1.5",
		"postcss": "^8.5.3",
		"postcss-load-config": "^6.0.1",
		"postcss-preset-env": "^10.1.5",
		"rollup": "^4.39.0",
		"rollup-plugin-esbuild": "^6.2.1",
		"rollup-plugin-postcss": "^4.0.2",
		"sass": "^1.86.3",
		"terser": "^5.39.0"
	},
	"browserslist": [
		"chrome >= 111",
		"edge >= 111",
		"firefox >= 113",
		"safari >= 16.4",
		"ios_saf >= 16.4"
	]
}
